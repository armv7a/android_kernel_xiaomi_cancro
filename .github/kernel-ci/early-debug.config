# Early boot logging for cancro / msm8974.
# MSM_DEBUG_UART_PHYS (0xF991E000) already comes from mach/msm_iomap-8974.h,
# so the generic CONFIG_DEBUG_UART_PHYS does not exist on this 3.4 tree.
CONFIG_DEBUG_KERNEL=y
CONFIG_DEBUG_LL=y
CONFIG_DEBUG_LL_UART_NONE=y
CONFIG_EARLY_PRINTK=y
# msm8974 uses the HS (high-speed) UART block
CONFIG_MSM_HAS_DEBUG_UART_HS=y
